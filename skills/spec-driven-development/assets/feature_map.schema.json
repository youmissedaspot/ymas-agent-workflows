{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "map_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
    },
    "document_version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*(?:\\.[0-9]+)*(?![\\s\\S])"
    },
    "kind": {
      "const": "derived-feature-map"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "scope",
        "omissions"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
          },
          "kind": {
            "enum": [
              "requirement",
              "architecture",
              "implementation",
              "tool"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "status": {
            "enum": [
              "accepted",
              "draft",
              "observed",
              "unknown"
            ]
          },
          "acceptance": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "locator",
          "sha256",
          "status",
          "acceptance"
        ]
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "observed",
              "planned",
              "partial",
              "retired"
            ]
          },
          "entrypoints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "user",
                    "system"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "kind",
                "description",
                "source",
                "locator"
              ]
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "gotchas": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "purpose",
          "status",
          "entrypoints",
          "prerequisites",
          "gotchas",
          "limits"
        ]
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "health",
                "seed",
                "reset",
                "exercise",
                "inspect",
                "snapshot",
                "logs",
                "screenshot",
                "perf",
                "cleanup"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "effects": {
            "enum": [
              "read",
              "owned-write",
              "destructive"
            ]
          },
          "target_scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "preview_argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "purpose",
          "source",
          "argv",
          "capabilities",
          "effects",
          "target_scope",
          "preview_argv",
          "limits"
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "ready",
              "blocked",
              "unsupported"
            ]
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "setup": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "exercise": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expectations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
                },
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "source",
                "statement"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "capture": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "kind",
                "capture"
              ]
            }
          },
          "cleanup": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "purpose",
          "status",
          "prerequisites",
          "setup",
          "exercise",
          "expectations",
          "evidence",
          "cleanup",
          "limits"
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
          },
          "type": {
            "enum": [
              "contains",
              "depends_on",
              "governed_by",
              "implemented_by",
              "verified_by",
              "uses_tool"
            ]
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
          },
          "basis": {
            "enum": [
              "specified",
              "observed",
              "unresolved"
            ]
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "from",
          "type",
          "to",
          "basis",
          "provenance"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "map_id",
    "document_version",
    "kind",
    "coverage",
    "sources",
    "features",
    "tools",
    "scenarios",
    "relations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived Feature Map",
  "description": "Recorded navigation and provenance, never product authority or permission to execute tools."
}
